# Copy to backend/.env and fill in. backend/.env is never committed.
# On Vercel, set the same names in Project → Settings → Environment Variables.

# MongoDB Atlas connection string (Atlas → Connect → Drivers) and database name
MONGODB_URI=mongodb+srv://<db_user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=amore

# Firebase project used for customer Google sign-in (the backend checks sign-in tokens against it)
FIREBASE_PROJECT_ID=amore-icecream

# Google accounts that may open the admin console with "Owner? Sign in with Google" (comma separated)
OWNER_EMAILS=aathifmhd2000@gmail.com

# First admin login. Used only when there is no admin yet; afterwards change passwords with
#   npm --prefix backend run set-admin -- Admin
# ADMIN_USERNAME=Admin
# ADMIN_PASSWORD=

# Optional: signs admin sessions. Without it a random secret is created once and kept in the database.
# SESSION_SECRET=
