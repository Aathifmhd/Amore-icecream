rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation for Orders
    function isValidOrder(data) {
      return data.orderReference is string && data.orderReference.size() <= 64 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.contactNumber is string && data.contactNumber.size() > 0 && data.contactNumber.size() <= 30 &&
             data.orderType in ['delivery', 'pickup'] &&
             data.branchId in ['akurana', 'colombo', 'arugambay'] &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.grandTotalLKR is number && data.grandTotalLKR >= 0 &&
             data.status in ['pending_confirmation', 'paid', 'confirmed', 'completed', 'cancelled'] &&
             (!('emailAddress' in data) || (data.emailAddress is string && data.emailAddress.size() <= 120)) &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 30)) &&
             (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 300)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('specialNote' in data) || (data.specialNote is string && data.specialNote.size() <= 500)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // Orders Collection
    match /orders/{orderId} {
      // Direct get by orderId (needed for order tracking / confirmation links)
      allow get: if isValidId(orderId);

      // List queries strictly enforced to owner
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Allow creating valid order
      allow create: if isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid));

      // Allow updating payment status or notes
      allow update: if isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().orderReference == existing().orderReference &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paidAt', 'paymentMethod', 'specialNote', 'cardLast4', 'cardBrand']);

      allow delete: if false;
    }

    // Validation for Reviews
    function isValidReview(data) {
      return data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() <= 500 &&
             (!('flavourOrBranch' in data) || (data.flavourOrBranch is string && data.flavourOrBranch.size() <= 100)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isValidId(reviewId) &&
                       isValidReview(incoming()) &&
                       (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid));

      allow update: if isValidId(reviewId) &&
                       isValidReview(incoming()) &&
                       isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId;

      allow delete: if isValidId(reviewId) &&
                       isSignedIn() &&
                       existing().userId == request.auth.uid;
    }

    // Validation for User Profiles
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('preferredBranch' in data) || data.preferredBranch in ['akurana', 'colombo', 'arugambay']) &&
             (!('favoriteFlavours' in data) || (data.favoriteFlavours is list && data.favoriteFlavours.size() <= 30));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if false;
    }
  }
}
