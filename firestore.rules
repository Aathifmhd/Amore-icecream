rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation for Orders
    function isValidOrder(data) {
      return data.orderReference is string && data.orderReference.size() <= 64 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.contactNumber is string && data.contactNumber.size() > 0 && data.contactNumber.size() <= 30 &&
             data.orderType in ['delivery', 'pickup'] &&
             data.branchId in ['akurana', 'colombo', 'arugambay'] &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.grandTotalLKR is number && data.grandTotalLKR >= 0 &&
             data.status in ['pending_confirmation', 'paid', 'confirmed', 'completed', 'cancelled'] &&
             (!('emailAddress' in data) || (data.emailAddress is string && data.emailAddress.size() <= 120)) &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 30)) &&
             (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 300)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('specialNote' in data) || (data.specialNote is string && data.specialNote.size() <= 500)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // Orders Collection
    match /orders/{orderId} {
      // Direct get by orderId (needed for order tracking / confirmation links)
      allow get: if isValidId(orderId);

      // List queries strictly enforced to owner
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Allow creating valid order
      allow create: if isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid));

      // Allow updating order status or payment info
      allow update: if isValidId(orderId) &&
                       (
                         // Allow owner or guest paying for this exact order
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'status',
                           'paidAt',
                           'paymentMethod',
                           'cardLast4',
                           'cardBrand',
                           'specialNote'
                         ]) &&
                         incoming().status in ['pending_confirmation', 'paid', 'confirmed', 'completed', 'cancelled']
                       );

      // Deny deletion of orders to preserve accounting history
      allow delete: if false;
    }

    // Test connection doc for initial boot validation
    match /test/connection {
      allow read: if true;
    }
  }
}
