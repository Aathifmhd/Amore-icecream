{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "An ice cream, coffee, or dessert order placed by a customer at Amore Speciality",
      "type": "object",
      "properties": {
        "orderReference": {
          "type": "string",
          "description": "Unique human-readable order reference like AMO-123456",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of order placement"
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name",
          "maxLength": 100
        },
        "contactNumber": {
          "type": "string",
          "description": "Phone number for order verification and delivery communication",
          "maxLength": 30
        },
        "whatsappNumber": {
          "type": "string",
          "description": "Optional WhatsApp number for receiving delivery receipt and order status",
          "maxLength": 30
        },
        "emailAddress": {
          "type": "string",
          "description": "Optional email address for e-receipt",
          "maxLength": 120
        },
        "orderType": {
          "type": "string",
          "description": "Whether the order is for home delivery or branch pickup",
          "enum": ["delivery", "pickup"]
        },
        "deliveryAddress": {
          "type": "string",
          "description": "Street address for home delivery orders",
          "maxLength": 300
        },
        "city": {
          "type": "string",
          "description": "City or area name in Sri Lanka",
          "maxLength": 100
        },
        "branchId": {
          "type": "string",
          "description": "Amore branch fulfilling the order",
          "enum": ["akurana", "colombo", "arugambay"]
        },
        "branchName": {
          "type": "string",
          "description": "Branch display name",
          "maxLength": 100
        },
        "branchCity": {
          "type": "string",
          "description": "City of fulfilling branch",
          "maxLength": 100
        },
        "specialNote": {
          "type": "string",
          "description": "Custom preparation requests, napkin counts, or delivery instructions",
          "maxLength": 500
        },
        "subtotalLKR": {
          "type": "number",
          "description": "Subtotal in Sri Lankan Rupees"
        },
        "deliveryFeeLKR": {
          "type": "number",
          "description": "Delivery fee in Sri Lankan Rupees"
        },
        "grandTotalLKR": {
          "type": "number",
          "description": "Final total payable in Sri Lankan Rupees"
        },
        "currency": {
          "type": "string",
          "description": "Display currency during checkout",
          "enum": ["LKR", "USD"]
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method chosen by customer",
          "enum": ["card", "cash", "bank_transfer"]
        },
        "status": {
          "type": "string",
          "description": "Current order lifecycle status",
          "enum": ["pending_confirmation", "paid", "confirmed", "completed", "cancelled"]
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID if user was logged in when placing order",
          "maxLength": 128
        },
        "paidAt": {
          "type": "string",
          "description": "ISO timestamp when order payment was authorized or collected"
        },
        "cardLast4": {
          "type": "string",
          "description": "Masked last 4 digits of payment card if paid via card gateway",
          "maxLength": 4
        },
        "cardBrand": {
          "type": "string",
          "description": "Payment card network brand (Visa, Mastercard, etc.)",
          "maxLength": 20
        }
      },
      "required": [
        "orderReference",
        "customerName",
        "contactNumber",
        "orderType",
        "branchId",
        "grandTotalLKR",
        "status"
      ]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Stores guest and customer ice cream orders, tracks live fulfillment status, and records payment confirmations"
    }
  }
}
